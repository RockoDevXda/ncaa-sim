import os
import re
import requests

ODDS_API_KEY = os.getenv("ODDS_API_KEY", "").strip()
NCAAB_ODDS_URL = "https://api.the-odds-api.com/v4/sports/basketball_ncaab/odds"

BOOK_TITLE_ALIASES = {
    "draftkings": "DraftKings",
    "fanduel": "FanDuel",
    "betmgm": "BetMGM",
    "caesars": "Caesars",
    "espnbet": "ESPN BET",
    "pinnacle": "Pinnacle",
    "hardrockbet": "Hard Rock Bet",
}


def _norm_team(name: str) -> str:
    s = re.sub(r"[^a-z0-9\s]", "", (name or "").lower())
    s = re.sub(
        r"\b(state|st|university|college|bulldogs|wildcats|tigers|eagles|bears|panthers|"
        r"cougars|huskies|commodores|seminoles|volunteers|boilermakers|tar heels|razorbacks|"
        r"hoosiers|hawkeyes|musketeers|billikens|gaels|broncos|vandals|mustangs|jaguars|"
        r"knights|cardinals|demons|horns|rams|flames|owls|hawks|lions|lancers|jaspers|"
        r"hurricanes|utes|flyers|skyhawks|salukis|blue hens|matadors|mean green|mountaineers|"
        r"cavaliers|chanticleers|spiders|hilltoppers|gamecocks|golden grizzlies|purple eagles|"
        r"colonials|revolutionaries|blazers|hokies|great danes|leathernecks|lumberjacks|"
        r"jackrabbits|bengals|pirates|wolverines|fighting camels|yellow jackets|fighting illini|"
        r"bearkats|roadrunners|thundering herd|hornets)\b",
        "",
        s,
    )
    return re.sub(r"\s+", " ", s).strip()


def _fmt_book(key: str, title: str = "") -> str:
    k = (key or "").lower().strip()
    if k in BOOK_TITLE_ALIASES:
        return BOOK_TITLE_ALIASES[k]
    return (title or "").strip() or k.upper()


def _am_to_imp(am: float) -> float:
    am = float(am)
    if am == 0:
        return 0.5
    return (100.0 / (am + 100.0)) if am > 0 else (abs(am) / (abs(am) + 100.0))


def _am_to_dec(am: float) -> float:
    am = float(am)
    if am == 0:
        return 1.909
    return (1.0 + am / 100.0) if am > 0 else (1.0 + 100.0 / abs(am))


def _imp_to_am(prob: float) -> int:
    p = max(0.01, min(0.99, float(prob)))
    return int(round(-100.0 * p / (1.0 - p))) if p >= 0.5 else int(round(100.0 * (1.0 - p) / p))


def _calc_ev(prob_pct: float, am_odds: float) -> float:
    p = max(0.0, min(1.0, float(prob_pct) / 100.0))
    q = 1.0 - p
    b = max(0.01, _am_to_dec(am_odds) - 1.0)
    return round(((p * b) - q) * 100.0, 1)


def fetch_ncaab_odds() -> list[dict]:
    if not ODDS_API_KEY:
        return []
    try:
        r = requests.get(
            NCAAB_ODDS_URL,
            params={
                "apiKey": ODDS_API_KEY,
                "regions": "us,eu",
                "markets": "spreads,totals",
                "oddsFormat": "american",
            },
            timeout=15,
        )
        print(f"Odds API NCAAB status: {r.status_code}")
        return r.json() if r.ok and isinstance(r.json(), list) else []
    except Exception as e:
        print(f"Odds API NCAAB error: {e}")
        return []


def _match_ncaab_event(game: dict, odds_events: list[dict]) -> dict | None:
    targets = {
        _norm_team(game.get("home_team", "")),
        _norm_team(game.get("home_short", "")),
    }
    away_targets = {
        _norm_team(game.get("away_team", "")),
        _norm_team(game.get("away_short", "")),
    }
    targets.discard("")
    away_targets.discard("")
    for ev in odds_events:
        oh = _norm_team(ev.get("home_team", ""))
        oa = _norm_team(ev.get("away_team", ""))
        h_ok = any(t in oh or oh in t for t in targets)
        a_ok = any(t in oa or oa in t for t in away_targets)
        if h_ok and a_ok:
            return ev
    return None


def _summarize_offers(offers: list[dict], model_prob_pct: float) -> dict:
    if not offers:
        return {
            "best_book": "Consensus (-110)",
            "best_odds": -110,
            "no_vig_odds": -110,
            "no_vig_prob": 50.0,
            "market_ev_pct": _calc_ev(model_prob_pct, -110),
        }
    best = max(offers, key=lambda x: _am_to_dec(x["price"]))
    fair_probs = []
    for o in offers:
        if o.get("opp_price") is not None:
            p1 = _am_to_imp(o["price"])
            p2 = _am_to_imp(o["opp_price"])
            if (p1 + p2) > 0:
                fair_probs.append(p1 / (p1 + p2))
        else:
            fair_probs.append(_am_to_imp(o["price"]))
    nv_p = (sum(fair_probs) / len(fair_probs)) if fair_probs else 0.5
    best_odds = int(best["price"])
    return {
        "best_book": best["book"],
        "best_odds": best_odds,
        "no_vig_odds": _imp_to_am(nv_p),
        "no_vig_prob": round(nv_p * 100.0, 1),
        "market_ev_pct": _calc_ev(model_prob_pct, best_odds),
    }


def enrich_ncaa_slate_with_odds(games: list[dict]) -> list[dict]:
    odds_events = fetch_ncaab_odds()
    for g in games:
        ev = _match_ncaab_event(g, odds_events)
        sp_offers = []
        tot_offers = []
        tot_side = "U" if str(g.get("total_pick", "")).startswith("U") else "O"

        if ev:
            for bm in (ev.get("bookmakers") or []):
                b_name = _fmt_book(bm.get("key", ""), bm.get("title", ""))
                for mkt in (bm.get("markets") or []):
                    mk = mkt.get("key")
                    outs = mkt.get("outcomes") or []
                    if mk == "spreads" and g.get("has_line"):
                        pick_str = str(g.get("spread_pick", ""))
                        pick_home = _norm_team(g.get("home_short", "")) in _norm_team(pick_str)
                        target_team = ev.get("home_team") if pick_home else ev.get("away_team")
                        opp_team = ev.get("away_team") if pick_home else ev.get("home_team")
                        m_out = next((o for o in outs if o.get("name") == target_team), None)
                        o_out = next((o for o in outs if o.get("name") == opp_team), None)
                        if m_out and m_out.get("price") is not None:
                            sp_offers.append({
                                "book": b_name,
                                "price": int(m_out["price"]),
                                "opp_price": int(o_out["price"]) if o_out and o_out.get("price") is not None else None,
                            })
                    elif mk == "totals" and g.get("has_total"):
                        want_name = "Under" if tot_side == "U" else "Over"
                        opp_name = "Over" if tot_side == "U" else "Under"
                        m_out = next((o for o in outs if o.get("name") == want_name), None)
                        o_out = next((o for o in outs if o.get("name") == opp_name), None)
                        if m_out and m_out.get("price") is not None:
                            tot_offers.append({
                                "book": b_name,
                                "price": int(m_out["price"]),
                                "opp_price": int(o_out["price"]) if o_out and o_out.get("price") is not None else None,
                            })

        sp_info = _summarize_offers(sp_offers, float(g.get("spread_cover_pct") or 55.0))
        tot_info = _summarize_offers(tot_offers, float(g.get("total_cover_pct") or 55.0))

        g["best_book"] = sp_info["best_book"]
        g["best_odds"] = sp_info["best_odds"]
        g["no_vig_odds"] = sp_info["no_vig_odds"]
        g["no_vig_prob"] = sp_info["no_vig_prob"]
        g["market_ev_pct"] = sp_info["market_ev_pct"]

        g["total_best_book"] = tot_info["best_book"]
        g["total_best_odds"] = tot_info["best_odds"]
        g["total_no_vig_odds"] = tot_info["no_vig_odds"]
        g["total_no_vig_prob"] = tot_info["no_vig_prob"]
        g["total_market_ev_pct"] = tot_info["market_ev_pct"]
    return games
